#!/usr/bin/env bash
# Galla CLI - make projects, resume them, and publish them to GitHub Pages.
set -euo pipefail

VERSION="1.0.0"
WORKSPACE="${GALLA_HOME:-$HOME/Galla}"
CONFIG_DIR="${GALLA_CONFIG_DIR:-$HOME/.galla}"
CONFIG="$CONFIG_DIR/config"
API="${GALLA_API:-https://api.github.com}"

say()  { printf '%s\n' "$*"; }
warn() { printf '%s\n' "$*" >&2; }
fail() { printf 'galla: %s\n' "$*" >&2; exit 1; }

for dep in git curl; do
    command -v "$dep" >/dev/null 2>&1 || fail "$dep is required but not installed."
done

# ----------------------------------------------------------------- config
# The token lives in one file, readable only by you. It is deliberately never
# written into a git remote: .git/config is world-readable and gets copied
# around with the project.
load_config() {
    GALLA_PAT=""; GALLA_USER=""; GALLA_CONNECT_TOKEN=""; GALLA_SAVED_MODEL=""
    # Must not end on a failed test: under `set -e` a function returning
    # non-zero takes the whole script down, which on a first run (no config
    # yet) killed every command before it printed anything.
    if [ -f "$CONFIG" ]; then . "$CONFIG"; fi
    return 0
}

save_config() {
    mkdir -p "$CONFIG_DIR"
    umask 077
    {
        printf 'GALLA_PAT=%s\n' "$(printf '%q' "$GALLA_PAT")"
        printf 'GALLA_USER=%s\n' "$(printf '%q' "$GALLA_USER")"
        printf 'GALLA_SAVED_MODEL=%s\n' "$(printf '%q' "${GALLA_SAVED_MODEL:-}")"
        # Persisted too, or pairing would break every time the connector
        # restarted with a freshly generated token.
        printf 'GALLA_CONNECT_TOKEN=%s\n' "$(printf '%q' "${GALLA_CONNECT_TOKEN:-}")"
    } > "$CONFIG"
    chmod 600 "$CONFIG"
}

# Minimal field reader so this works on a phone without jq installed.
json_field() { grep -o "\"$2\"[[:space:]]*:[[:space:]]*\"[^\"]*\"" <<<"$1" | head -n1 | sed 's/.*:[[:space:]]*"//; s/"$//'; }
json_all()   { grep -o "\"$2\"[[:space:]]*:[[:space:]]*\"[^\"]*\"" <<<"$1" | sed 's/.*:[[:space:]]*"//; s/"$//'; }

api() {
    local method="$1" path="$2" body="${3:-}"
    local args=(-sS -X "$method"
        -H "Accept: application/vnd.github+json"
        -H "X-GitHub-Api-Version: 2022-11-28"
        -H "Authorization: Bearer $GALLA_PAT"
        -w '\n%{http_code}')
    [ -n "$body" ] && args+=(-H "Content-Type: application/json" -d "$body")
    curl "${args[@]}" "$API$path"
}

# git prints the URL it failed on, and for a push that URL carries the token.
# Anything from git therefore goes through here before it is shown.
# [ -r /dev/tty ] only asks whether the path exists and is readable, which it
# is even for a process with no controlling terminal -- under setsid or a
# service the open then fails. Opening it is the only honest test. stderr is
# redirected before the open, because bash reports a failed redirect through
# the shell's stderr, not the command's.
tty_readable() { { : < /dev/tty; } 2>/dev/null; }

redact() {
    if [ -n "${GALLA_PAT:-}" ]; then
        sed "s|$GALLA_PAT|***|g"
    else
        cat
    fi
}

# Status code and GitHub's own message for one call, for diagnosing rather
# than doing. Prints "<code> <message>".
api_probe() {
    local out code body
    out="$(api "$@" 2>/dev/null)" || { printf '??? could not reach GitHub'; return 1; }
    code="$(tail -n1 <<<"$out")"
    body="$(sed '$d' <<<"$out")"
    printf '%s %s' "$code" "$(json_field "$body" message)"
}

api_ok() {   # prints the body, returns non-zero on an HTTP error
    local out code
    out="$(api "$@")" || return 1
    code="$(tail -n1 <<<"$out")"
    out="$(sed '$d' <<<"$out")"
    printf '%s' "$out"
    [ "$code" -ge 200 ] && [ "$code" -lt 300 ]
}

require_auth() {
    load_config
    [ -n "$GALLA_PAT" ] || fail "no GitHub token saved yet. Run 'galla auth' first."
}

# ------------------------------------------------------------------ paths
project_dir() { printf '%s/%s' "$WORKSPACE" "$1"; }

require_project() {
    local dir; dir="$(project_dir "$1")"
    [ -d "$dir" ] || fail "no project called '$1'. 'galla list' shows what you have."
    printf '%s' "$dir"
}

project_repo() {   # owner/name this project is linked to, if any
    local dir="$1"
    [ -f "$dir/.galla/repo" ] && cat "$dir/.galla/repo" || true
}

# .galla is Galla's own bookkeeping. Without this it gets committed and
# published to the repository along with the site.
ensure_gitignore() {
    local dir="$1"
    if [ ! -f "$dir/.gitignore" ] || ! grep -qx '\.galla/' "$dir/.gitignore" 2>/dev/null; then
        printf '.galla/\n' >> "$dir/.gitignore"
    fi
    # Self-heal a project created before this rule existed.
    if git -C "$dir" ls-files --error-unmatch .galla >/dev/null 2>&1; then
        git -C "$dir" rm -r --cached -q .galla
    fi
}

# Reads a secret showing a dot per character. `read -s` shows nothing at all,
# which on a phone is indistinguishable from a frozen prompt -- you cannot tell
# whether a paste registered, so it looks broken.
read_masked() {
    local ch secret=""
    while IFS= read -r -s -n 1 ch; do
        [ -z "$ch" ] && break                       # Enter ends it
        case "$ch" in
            $'\177'|$'\b')                          # backspace
                if [ -n "$secret" ]; then
                    secret="${secret%?}"
                    printf '\b \b' >&2
                fi
                ;;
            *) secret="$secret$ch"; printf '.' >&2 ;;
        esac
    done
    printf '\n' >&2
    printf '%s' "$secret"
}

# ------------------------------------------------------------------- auth
# What to tick when making the token. Printed only when we are about to ask
# for one -- someone who already has it in hand does not need the recipe.
auth_instructions() {
    say "Galla needs a GitHub fine-grained token to create repos and push."
    say ""
    say "Make one at: https://github.com/settings/personal-access-tokens/new"
    say ""
    say "  Repository access:  All repositories"
    say "    One limited to selected repositories cannot create a new repo,"
    say "    and would not cover a repo you make tomorrow."
    say ""
    say "  Repository permissions:"
    say "    Contents          Read and write    push your files"
    say "    Administration    Read and write    create the repository"
    say "    Pages             Read and write    switch the site on"
    say "    Pull requests     Read and write    when the site has moved on without you"
    say "    Metadata          Read-only         ticked for you already"
    say ""
    say "    Workflows too, if you want Actions later."
    say ""
    say "  Fine-grained tokens expire. When yours does, run 'galla auth' again."
    say ""
}

cmd_auth() {
    load_config

    # Three ways in, so a terminal that will not cooperate is never a dead end:
    #   galla auth github_pat_xxx              argument
    #   GALLA_TOKEN=github_pat_xxx galla auth  environment
    #   the prompt below                       typed or pasted
    local token="${1:-${GALLA_TOKEN:-}}"

    if [ -z "$token" ]; then
        auth_instructions
        if [ -n "$GALLA_PAT" ]; then
            say "A token is already saved. Entering a new one replaces it."
            say ""
        fi
        if [ -t 0 ]; then
            printf 'Paste your token, then press Enter: '
            token="$(read_masked)"
        else
            read -r token || true
        fi
    fi

    if [ -z "$token" ]; then
        say ""
        say "No token received."
        say ""
        say "If pasting into the prompt does not work on your terminal, pass it"
        say "directly instead:"
        say ""
        say "    galla auth github_pat_your_token_here"
        say ""
        exit 1
    fi

    GALLA_PAT="$token"
    local body login
    body="$(api_ok GET /user)" ||
        fail "GitHub rejected that token. Check it was copied whole, and that it hasn't expired."
    login="$(json_field "$body" login)"
    [ -n "$login" ] || fail "could not read the account for that token."

    GALLA_USER="$login"
    save_config
    say "Signed in as $GALLA_USER. Token saved to $CONFIG (readable only by you)."

    # A classic token still works; the permissions above just aren't how it is
    # described. Worth one line so a later refusal isn't a mystery.
    case "$token" in
        ghp_*|gho_*|ghu_*)
            say ""
            say "(That's a classic token. It works, but its scopes are named"
            say " differently - if something later says it isn't allowed, start there.)"
            ;;
    esac

    # Whether the permissions are right can't be read off the token: GitHub
    # reports a fine-grained token's permissions nowhere, only refusals at the
    # point of use. So the checks that matter live where they are used.
}

cmd_whoami() {
    require_auth
    say "$GALLA_USER"
    say "token: $CONFIG"
}

# --------------------------------------------------------------- projects
cmd_new() {
    local name="${1:-}"
    [ -n "$name" ] || fail "usage: galla new <name>"
    case "$name" in */*|.*) fail "'$name' is not a valid project name." ;; esac

    local dir; dir="$(project_dir "$name")"
    if [ -e "$dir" ]; then fail "'$name' already exists. 'galla open $name' to resume it."; fi

    mkdir -p "$dir/.galla"
    cat > "$dir/index.html" <<HTML
<!DOCTYPE html>
<html lang="en">
<head>
<meta charset="UTF-8">
<meta name="viewport" content="width=device-width, initial-scale=1.0">
<title>$name</title>
</head>
<body>
<h1>$name</h1>
<p>Made with Galla.</p>
</body>
</html>
HTML
    printf '# %s\n\nMade with Galla.\n' "$name" > "$dir/README.md"
    ensure_gitignore "$dir"

    git -C "$dir" init -q
    git -C "$dir" symbolic-ref HEAD refs/heads/main
    git -C "$dir" add -A
    git -C "$dir" -c user.name="Galla" -c user.email="galla@localhost" \
        commit -qm "Start $name" || true

    say "Created $dir"
    say ""
    say "  galla open $name        work on it"
    say "  galla link $name        attach a GitHub repo"
    say "  galla publish $name     push it live"
}

cmd_list() {
    [ -d "$WORKSPACE" ] || { say "No projects yet. 'galla new <name>' makes one."; return; }
    local found=0 dir name repo
    for dir in "$WORKSPACE"/*/; do
        [ -d "$dir" ] || continue
        found=1
        name="$(basename "$dir")"
        repo="$(project_repo "${dir%/}")"
        if [ -n "$repo" ]; then
            printf '  %-24s %s\n' "$name" "$repo"
        else
            printf '  %-24s %s\n' "$name" "(not linked)"
        fi
    done
    [ "$found" -eq 1 ] || say "No projects yet. 'galla new <name>' makes one."
}

cmd_open() {
    local name="${1:-}"
    [ -n "$name" ] || fail "usage: galla open <name>"
    local dir; dir="$(require_project "$name")"
    say "Opening $dir - type 'exit' to come back."
    cd "$dir"
    exec "${SHELL:-/bin/bash}"
}

# ------------------------------------------------------------------- link
cmd_link() {
    require_auth
    local name="${1:-}" repo="${2:-}"
    [ -n "$name" ] || fail "usage: galla link <project> [owner/repo]"
    local dir; dir="$(require_project "$name")"

    if [ -z "$repo" ]; then
        say "Your repositories:"
        local body list i=1
        body="$(api_ok GET "/user/repos?per_page=100&sort=updated")" ||
            fail "could not list your repositories."
        list="$(json_all "$body" full_name)"
        if [ -n "$list" ]; then
            while IFS= read -r r; do printf '  %2d) %s\n' "$i" "$r"; i=$((i+1)); done <<<"$list"
        fi
        say "   n) create a new repository called '$name'"
        say ""
        printf 'Pick a number, or n: '
        local choice; read -r choice
        if [ "$choice" = "n" ] || [ "$choice" = "N" ]; then
            say "Creating $GALLA_USER/$name ..."
            local created
            created="$(api_ok POST /user/repos "{\"name\":\"$name\",\"private\":false,\"auto_init\":false}")" || {
                warn "galla: could not create the repository: $(json_field "$created" message)"
                warn ""
                warn "Creating a repo needs a fine-grained token with:"
                warn "  Repository access     All repositories"
                warn "  Administration        Read and write"
                warn ""
                warn "Or make the repo on github.com and run: galla link $name owner/repo"
                exit 1
            }
            repo="$(json_field "$created" full_name)"
        else
            repo="$(sed -n "${choice}p" <<<"$list")"
            [ -n "$repo" ] || fail "'$choice' wasn't one of the options."
        fi
    fi

    mkdir -p "$dir/.galla"
    printf '%s' "$repo" > "$dir/.galla/repo"
    # No token in the remote: it is added only for the seconds a push takes.
    git -C "$dir" remote remove origin 2>/dev/null || true
    git -C "$dir" remote add origin "https://github.com/$repo.git"

    say "Linked '$name' to $repo"
    say "Next: galla publish $name"
}

# ---------------------------------------------------------------- publish
pages_url() {
    local repo="$1" owner name
    owner="$(printf '%s' "${repo%%/*}" | tr '[:upper:]' '[:lower:]')"
    name="${repo##*/}"
    printf 'https://%s.github.io/%s/' "$owner" "$name"
}

# The remote has commits we don't. Rather than stopping, work out whether
# that is a real disagreement or just two people touching different files.
#
# A merge that succeeds on its own is not a guess: git only manages it when
# the two sides changed different things. When they changed the same lines,
# choosing between them is a decision, and this is not the place to make it --
# so that version goes on a branch and becomes a pull request, where both
# copies survive and you decide on github.com.
publish_diverged() {
    local dir="$1" repo="$2" push_url="$3" name="$4"
    local gitc=(git -C "$dir" -c "user.name=${GALLA_USER:-Galla}"
                -c "user.email=${GALLA_USER:-galla}@users.noreply.github.com")

    say ""
    say "$repo has work your copy doesn't - something else pushed to it,"
    say "most likely an edit made on github.com."
    say ""
    say "Fetching it to compare ..."
    if ! git -C "$dir" fetch -q "$push_url" main 2>/dev/null; then
        fail "could not fetch $repo to compare against. Check your connection."
    fi

    if "${gitc[@]}" merge --no-edit -q FETCH_HEAD >/dev/null 2>&1; then
        local err
        if err="$(git -C "$dir" push -q "$push_url" main 2>&1)"; then
            say "They didn't overlap, so both are in. Pushed."
            return 0
        fi
        warn "galla: combined them, but the push still failed:"
        printf '%s\n' "$err" | redact | sed 's/^/  /' >&2
        exit 1
    fi

    "${gitc[@]}" merge --abort >/dev/null 2>&1 || true

    # The same lines changed on both sides. Someone has to choose, but that
    # someone is standing right here -- so ask, and skip the pull request
    # entirely. A branch you have to go and merge is only worth it when there
    # is nobody to ask.
    #
    # Either answer merges rather than force-pushes: the version not chosen
    # stays in the history, so nothing is destroyed by picking wrong.
    local ans=""
    if tty_readable; then
        say ""
        say "The same lines changed in both your copy and $repo."
        say ""
        say "  1) keep mine      - what is in $name now wins"
        say "  2) keep theirs    - what is on GitHub wins"
        say "  3) neither yet    - open a pull request and decide there"
        say ""
        printf 'Which? [1/2/3] '
        read -r ans 2>/dev/null < /dev/tty || ans=""
    fi

    local strategy=""
    case "$ans" in
        1) strategy=ours ;;
        2) strategy=theirs ;;
    esac

    if [ -n "$strategy" ]; then
        if ! "${gitc[@]}" merge --no-edit -q -X "$strategy" FETCH_HEAD >/dev/null 2>&1; then
            "${gitc[@]}" merge --abort >/dev/null 2>&1 || true
            warn "galla: could not combine them that way. Falling back to a branch."
        else
            local err
            if err="$(git -C "$dir" push -q "$push_url" main 2>&1)"; then
                if [ "$strategy" = ours ]; then
                    say "Kept yours. Pushed."
                else
                    say "Kept the GitHub version. Pushed."
                    say "(Your files in $name now match it.)"
                fi
                say ""
                say "Nothing was thrown away - the other version is still in the"
                say "repository's history."
                return 0
            fi
            warn "galla: combined them, but the push failed:"
            printf '%s\n' "$err" | redact | sed 's/^/  /' >&2
            exit 1
        fi
    fi

    local branch="galla-$(date +%Y%m%d-%H%M%S)"
    say ""
    say "Putting your version on a branch to decide on later."
    say ""
    say "Nothing already on $repo is changed or lost."
    say ""
    local err
    if ! err="$(git -C "$dir" push -q "$push_url" "main:refs/heads/$branch" 2>&1)"; then
        warn "galla: could not push the branch:"
        printf '%s\n' "$err" | redact | sed 's/^/  /' >&2
        exit 1
    fi
    say "Pushed branch $branch"

    local body pr_url
    body="$(api_ok POST "/repos/$repo/pulls" \
        "{\"title\":\"Changes from Galla ($branch)\",\"head\":\"$branch\",\"base\":\"main\",\"body\":\"Published from the Galla CLI. The same lines changed here and on main, so this is a pull request rather than a direct push - open the Files changed tab to see both versions.\"}" 2>/dev/null)" \
        && pr_url="$(json_field "$body" html_url)" || pr_url=""

    say ""
    if [ -n "$pr_url" ]; then
        say "Opened a pull request:"
        say "  $pr_url"
        say ""
        say "Open it, look at 'Files changed', and merge it if it looks right."
    else
        # Creating one needs Pull requests: Read and write. Without it the
        # branch is still safely pushed, and GitHub will open the same
        # comparison from a URL.
        say "Couldn't open the pull request itself"
        [ -n "$body" ] && say "  ($(json_field "$body" message))"
        say ""
        say "The branch is pushed, so open it here instead:"
        say "  https://github.com/$repo/compare/main...$branch"
        say ""
        say "(Adding 'Pull requests: Read and write' to the token lets galla"
        say " open it for you next time.)"
    fi

    say ""
    say "Until that is merged, 'galla publish $name' will land here again -"
    say "your copy still differs from main."
}

cmd_publish() {
    require_auth
    local name="${1:-}"; shift || true
    [ -n "$name" ] || fail "usage: galla publish <project> [message]"
    local dir; dir="$(require_project "$name")"
    local msg="${*:-Update $name}"

    local repo; repo="$(project_repo "$dir")"
    [ -n "$repo" ] || fail "'$name' isn't linked to a repository yet. Run 'galla link $name'."

    ensure_gitignore "$dir"
    git -C "$dir" add -A
    if git -C "$dir" diff --cached --quiet 2>/dev/null; then
        say "Nothing changed since the last publish."
    else
        git -C "$dir" -c user.name="${GALLA_USER:-Galla}" \
            -c user.email="${GALLA_USER:-galla}@users.noreply.github.com" \
            commit -qm "$msg"
        say "Committed: $msg"
    fi

    git -C "$dir" branch -M main
    say "Pushing to $repo ..."

    # The token is interpolated into this one command and never stored, and
    # only for github.com -- any other remote keeps whatever auth it already
    # has rather than being handed a GitHub token.
    local remote push_url
    remote="$(git -C "$dir" remote get-url origin)"
    push_url="$remote"
    case "$remote" in
        https://github.com/*)
            push_url="https://x-access-token:$GALLA_PAT@github.com/${remote#https://github.com/}"
            ;;
    esac

    local push_err
    if ! push_err="$(git -C "$dir" push -q "$push_url" main 2>&1)"; then
        case "$push_err" in
            # The remote moved on without us -- almost always an edit made on
            # github.com. Nothing is wrong and nothing needs fixing by hand;
            # the two versions just need reconciling.
            *"fetch first"*|*non-fast-forward*|*"Updates were rejected"*)
                publish_diverged "$dir" "$repo" "$push_url" "$name"
                return
                ;;
        esac
        warn "galla: push to $repo failed. git said:"
        warn ""
        printf '%s\n' "$push_err" | redact | sed 's/^/  /' >&2
        # Only offer the permission reading when it could be one. Saying it
        # after an error that is plainly about something else is noise that
        # sends you to check a token that was never the problem.
        case "$push_err" in
            *[Aa]uthentication*|*[Pp]ermission*|*403*|*[Dd]enied*|*[Uu]nauthorized*)
                warn ""
                warn "The token needs Contents: Read and write on $repo, and must not"
                warn "have expired. 'galla doctor $name' checks."
                ;;
        esac
        exit 1
    fi
    say "Pushed."

    local site; site="$(pages_url "$repo")"
    local existing
    if existing="$(api_ok GET "/repos/$repo/pages" 2>/dev/null)"; then
        say ""
        say "Live at: $site"
        say "Your change appears in about a minute."
        return
    fi

    say ""
    say "Turning on GitHub Pages ..."
    local pages_body pages_msg
    if pages_body="$(api_ok POST "/repos/$repo/pages" '{"source":{"branch":"main","path":"/"}}' 2>/dev/null)"; then
        say "Pages is on."
        say ""
        say "Live at: $site"
        say "The first build takes about a minute."
    else
        # Say what GitHub said, not what we guess it meant. Every cause below
        # arrives as the same failed POST, and only the message tells them
        # apart -- an earlier version asserted "add the Pages permission" for
        # all of them, which is wrong whenever the token was already fine.
        pages_msg="$(json_field "$pages_body" message)"
        say "Couldn't switch Pages on."
        if [ -n "$pages_msg" ]; then
            say ""
            say "  GitHub said: $pages_msg"
        fi
        say ""
        case "$pages_msg" in
            *[Uu]pgrade*|*private*|*[Pp]lan*)
                say "That is about the repository being private, not about the token:"
                say "Pages on a private repo needs a paid plan. Making $repo public"
                say "is the free way, or do it by hand below."
                ;;
            *"not accessible by personal access token"*)
                say "That is the token. Check, at"
                say "https://github.com/settings/personal-access-tokens :"
                say "  - Pages is set to Read and write"
                say "  - the resource owner is $GALLA_USER, not an organisation"
                say "  - repository access covers $repo"
                ;;
            *"Not Found"*)
                say "A 'Not Found' here usually means the token cannot see $repo at all"
                say "- it is scoped to selected repositories and this one is not among"
                say "them, or its resource owner is a different account."
                ;;
        esac
        say ""
        say "Or just do it once by hand:"
        say ""
        say "  1. Open https://github.com/$repo/settings/pages"
        say "  2. Under 'Build and deployment', set Source to 'Deploy from a branch'"
        say "  3. Pick branch 'main' and folder '/ (root)', then Save"
        say "  4. Wait about a minute for the link to appear"
        say ""
        say "It will be: $site"
    fi
    say ""
    say "From now on 'galla publish $name' updates the site in about a minute."
}

# ----------------------------------------------------------------- doctor
# "It says I need the permission, but I have it." Publishing can fail for
# several reasons that all surface as one refused call, so this asks GitHub
# about each one separately and reports what came back rather than guessing.
cmd_doctor() {
    require_auth
    local name="${1:-}" repo="" dir=""
    if [ -n "$name" ]; then
        dir="$(require_project "$name")"
        repo="$(project_repo "$dir")"
    fi

    say "Token"
    local body code
    body="$(api GET /user 2>/dev/null)" || { say "  cannot reach GitHub."; return 1; }
    code="$(tail -n1 <<<"$body")"; body="$(sed '$d' <<<"$body")"
    if [ "$code" != "200" ]; then
        say "  REJECTED  $(json_field "$body" message)"
        say ""
        say "  The token is wrong or has expired. Run 'galla auth' with a new one."
        return 1
    fi
    say "  ok        signed in as $(json_field "$body" login)"

    if [ -z "$repo" ]; then
        say ""
        if [ -n "$name" ]; then
            say "'$name' isn't linked to a repository yet - run 'galla link $name'."
        else
            say "Name a project to check its repository too:  galla doctor <project>"
        fi
        return 0
    fi

    say ""
    say "Repository  $repo"
    body="$(api GET "/repos/$repo" 2>/dev/null)"
    code="$(tail -n1 <<<"$body")"; body="$(sed '$d' <<<"$body")"
    case "$code" in
        200)
            local private; private="$(grep -o '"private"[[:space:]]*:[[:space:]]*[a-z]*' <<<"$body" | head -n1 | grep -o '[a-z]*$')"
            if [ "$private" = "true" ]; then
                say "  visible   yes, and it is PRIVATE"
                say "            Pages on a private repo needs a paid plan. This is the"
                say "            most common reason publishing refuses a token that is"
                say "            in fact correct. Making it public is the free fix."
            else
                say "  visible   yes, public"
            fi
            ;;
        404)
            say "  NOT FOUND to this token."
            say "            The repo may not exist, or the token is scoped to selected"
            say "            repositories and this is not one of them, or its resource"
            say "            owner is a different account. GitHub returns 404 rather"
            say "            than 403 here, so it looks like the repo is missing."
            return 1
            ;;
        *)  say "  $code  $(json_field "$body" message)" ;;
    esac

    say ""
    say "Permissions, as GitHub answers them"
    local probe
    probe="$(api_probe GET "/repos/$repo/pages")"
    case "$probe" in
        200*) say "  Pages     read ok, and Pages is already switched on" ;;
        404*) say "  Pages     read ok, Pages not switched on yet" ;;
        403*) say "  Pages     REFUSED - ${probe#403 }" ;;
        *)    say "  Pages     $probe" ;;
    esac

    probe="$(api_probe GET "/repos/$repo/pulls?per_page=1")"
    case "$probe" in
        200*) say "  Pull req. read ok" ;;
        403*) say "  Pull req. REFUSED - ${probe#403 }" ;;
        *)    say "  Pull req. $probe" ;;
    esac

    # Contents cannot be probed without writing, so ask git the same question
    # a push asks, which authenticates without changing anything.
    local remote push_url
    remote="$(git -C "$dir" remote get-url origin 2>/dev/null || printf '')"
    if [ -n "$remote" ]; then
        push_url="$remote"
        case "$remote" in
            https://github.com/*) push_url="https://x-access-token:$GALLA_PAT@github.com/${remote#https://github.com/}" ;;
        esac
        local ls_err
        if ls_err="$(git ls-remote "$push_url" HEAD 2>&1)"; then
            say "  Contents  git can authenticate to $repo"
        else
            say "  Contents  git could NOT authenticate:"
            printf '%s\n' "$ls_err" | redact | sed 's/^/              /'
        fi
    fi

    say ""
    say "If everything above is ok but publishing still refuses, the message"
    say "'galla publish $name' prints is now GitHub's own - send that."
}

# ------------------------------------------------------------------- chat
# Chat needs Ollama, not GitHub, so it works with no token saved.
CHAT_ENDPOINTS="${GALLA_OLLAMA:-http://localhost:11434 https://ollama-tunnel.serveousercontent.com}"
DEFAULT_MODEL="treyleo16/gpt-5-6-sol"

# The models Galla runs on, and the only ones it will run on — the same five
# the chat app offers, so a project behaves the same whichever end you drive
# it from. Fields: id | name | other ways to say it.
GALLA_MODELS="\
treyleo16/gpt-5-6-sol|GPT 5.6 Sol|sol
rhododendron/galla:sonnet-1|GallaSonnet 1 Pro|sonnet-1 sonnet
rhododendron/galla:opus-1|GallaOpus 1|opus-1 opus
rhododendron/galla:1|Galla 1|1
rhododendron/galla:1-pro|Galla 1 Pro|1-pro"

# Ignore the capitals and punctuation people reasonably differ on, so
# "GallaOpus 1", "galla:opus-1" and "opus" are all one name.
model_key() {
    printf '%s' "$1" | tr 'A-Z' 'a-z' | tr -d ' .:/_-'
}

# A name -> the id to send to Ollama. Nothing outside the roster resolves,
# which is what keeps the roster meaningful.
model_id() {
    local want; want="$(model_key "$1")"
    if [ -z "$want" ]; then return 1; fi
    local id name aliases a
    while IFS='|' read -r id name aliases; do
        if [ -z "$id" ]; then continue; fi
        if [ "$want" = "$(model_key "$id")" ] || [ "$want" = "$(model_key "$name")" ]; then
            printf '%s' "$id"; return 0
        fi
        for a in $aliases; do
            if [ "$want" = "$(model_key "$a")" ]; then printf '%s' "$id"; return 0; fi
        done
    done <<<"$GALLA_MODELS"
    return 1
}

# Which model to talk to, most specific first: this one command, then the one
# you chose with `galla model`, then the default. A name off the roster stops
# here rather than reaching Ollama.
chat_model() {
    local want source fix
    if [ -n "${GALLA_MODEL:-}" ]; then
        want="$GALLA_MODEL"
        source="GALLA_MODEL in this shell"
        fix="galla models   lists the ones there are."
    else
        load_config
        want="${GALLA_SAVED_MODEL:-$DEFAULT_MODEL}"
        source="galla model"
        # An older galla saved any name at all, so a config can arrive here
        # holding one. Name the one command that clears it.
        fix="galla model default   puts it back to $DEFAULT_MODEL."
    fi
    local id
    if id="$(model_id "$want")"; then
        printf '%s' "$id"; return 0
    fi
    warn "galla: '$want' is not a Galla model (set by $source)."
    warn "       $fix"
    return 1
}

# What Ollama has pulled, one name per line, :latest trimmed.
pulled_models() {
    curl -fsS --max-time 8 "$1/api/tags" 2>/dev/null |
        grep -o '"name":"[^"]*"' | sed 's/.*:"//; s/"$//; s/:latest$//'
}

cmd_models() {
    local base pulled="" reachable=""
    if base="$(chat_endpoint)"; then
        reachable=yes
        pulled="$(pulled_models "$base")"
    fi

    local current=""
    current="$(chat_model)" || current=""

    say "Galla models:"
    say ""
    local id name aliases mark status
    while IFS='|' read -r id name aliases; do
        if [ -z "$id" ]; then continue; fi
        if [ "$id" = "$current" ]; then mark="*"; else mark=" "; fi
        status=""
        if [ -n "$reachable" ] && ! printf '%s\n' "$pulled" | grep -Fqx "$id"; then
            status="not pulled"
        fi
        if [ "$id" = "$current" ]; then
            if [ -n "$status" ]; then status="in use, $status"; else status="in use"; fi
        fi
        printf ' %s %-30s %-18s %s\n' "$mark" "$id" "$name" "$status"
    done <<<"$GALLA_MODELS"

    say ""
    if [ -z "$reachable" ]; then
        say "(Ollama isn't running, so I can't say which of these are pulled.)"
    fi
    say "Switch with:  galla model opus-1"
}

cmd_model() {
    local wanted="${1:-}"
    if [ -z "$wanted" ]; then
        local current
        current="$(chat_model)" || return 1
        say "$current"
        if [ -n "${GALLA_MODEL:-}" ]; then
            say "(from GALLA_MODEL in this shell, which wins over the saved one)"
        fi
        return 0
    fi

    if [ "$wanted" = "default" ] || [ "$wanted" = "reset" ]; then
        load_config; GALLA_SAVED_MODEL=""; save_config
        say "Back to the default: $DEFAULT_MODEL"
        return 0
    fi

    local id
    if ! id="$(model_id "$wanted")"; then
        warn "galla: there is no Galla model called '$wanted'."
        warn "       galla models   lists the ones there are."
        return 1
    fi

    # Not pulled is worth saying, not worth refusing over: Ollama may simply
    # not be running, and being unable to check is not evidence of anything.
    local base
    if base="$(chat_endpoint)"; then
        if ! pulled_models "$base" | grep -Fqx "$id"; then
            warn "note: $id isn't pulled on this machine yet."
            warn "      ollama pull $id"
        fi
    fi

    load_config; GALLA_SAVED_MODEL="$id"; save_config
    say "Galla will use $id."
}

# Text -> the inside of a JSON string.
json_escape() {
    printf '%s' "$1" | awk '
        BEGIN { ORS = "" }
        {
            line = $0
            gsub(/\\/, "\\\\", line)
            gsub(/"/,  "\\\"", line)
            gsub(/\t/, "\\t",  line)
            if (NR > 1) print "\\n"
            print line
        }'
}

# NDJSON lines -> the text they carry. Ollama escapes < > & as < and
# friends, which is most of an HTML file, so those have to come back.
ndjson_text() {
    awk '
        function uchar(code) {
            if (code == "003c") return "<"
            if (code == "003e") return ">"
            if (code == "0026") return "&"
            if (code == "0027") return "\x27"
            if (code == "0022") return "\""
            return ""
        }
        function unesc(s,   out, i, c, n, code) {
            out = ""; i = 1; n = length(s)
            while (i <= n) {
                c = substr(s, i, 1)
                if (c == "\\") {
                    i++; c = substr(s, i, 1)
                    if (c == "n")      out = out "\n"
                    else if (c == "t") out = out "\t"
                    else if (c == "r") { }
                    else if (c == "u") { code = substr(s, i + 1, 4); i += 4; out = out uchar(code) }
                    else out = out c
                } else out = out c
                i++
            }
            return out
        }
        {
            if (!match($0, /"content":"/)) next
            rest = substr($0, RSTART + 11)
            out = ""; i = 1
            while (i <= length(rest)) {
                ch = substr(rest, i, 1)
                if (ch == "\\") { out = out ch substr(rest, i + 1, 1); i += 2; continue }
                if (ch == "\"") break
                out = out ch; i++
            }
            printf "%s", unesc(out)
            fflush()
        }'
}

chat_endpoint() {
    local base
    for base in $CHAT_ENDPOINTS; do
        if curl -fsS --max-time 4 "$base/api/tags" >/dev/null 2>&1; then
            printf '%s' "$base"; return 0
        fi
    done
    return 1
}

# The project's files, so Galla can see what it is editing. Bounded, because
# everything here is re-sent with the request.
project_context() {
    local dir="$1" f rel size total=0
    while IFS= read -r f; do
        rel="${f#"$dir"/}"
        size=$(wc -c < "$f")
        [ "$size" -gt 20000 ] && continue
        grep -Iq . "$f" 2>/dev/null || continue     # text only
        total=$((total + size))
        [ "$total" -gt 60000 ] && break
        printf '\n--- %s ---\n' "$rel"
        cat "$f"
    done < <(find "$dir" -type f -not -path '*/.git/*' -not -path '*/.galla/*' | sort)
}

CHAT_BRIEF='You are Galla, working in a project folder on the user'"'"'s machine.
To create or change a file, write a fenced code block whose opening line is the
file path and nothing else:

```index.html
<!DOCTYPE html>
...
```

That block is written to that path exactly as given, so output the whole file,
never a fragment or a diff. Outside the blocks, say briefly what you changed.
If nothing needs writing, just answer.'

# Pull ```path ... ``` blocks out of a reply and write them.
write_files() {
    local dir="$1" reply="$2" wrote=0 path dest ans nf body
    local tmp; tmp="$(mktemp -d)"

    printf '%s' "$reply" | awk -v out="$tmp" '
        /^[ \t]*```/ {
            if (inblock) { inblock = 0; close(target); next }
            info = $0
            sub(/^[ \t]*```/, "", info)
            gsub(/^[ \t]+|[ \t]+$/, "", info)
            # a path, not a language tag: contains a dot, no spaces
            if (info ~ /\./ && info !~ /[ \t]/) {
                n++; target = out "/" n
                printf "%s", info > (target ".name"); close(target ".name")
                inblock = 1
            }
            next
        }
        inblock { print > target }
    '

    for nf in "$tmp"/*.name; do
        [ -e "$nf" ] || continue
        path="$(cat "$nf")"
        body="${nf%.name}"
        [ -e "$body" ] || continue
        case "$path" in
            /*|*..*) warn "  refused $path - it points outside the project"; continue ;;
        esac
        dest="$dir/$path"
        if [ -e "$dest" ]; then
            # New files are written freely; anything that already exists is
            # your work until you say otherwise. The answer has to come from the
            # terminal, since the chat loop is already reading stdin -- and with
            # no terminal at all the answer is no.
            ans=""
            if tty_readable; then
                printf '  overwrite %s? [y/N] ' "$path"
                read -r ans 2>/dev/null < /dev/tty || ans=""
            fi
            case "$ans" in
                [yY]*) ;;
                *) say "  kept $path as it was"; continue ;;
            esac
        fi
        mkdir -p "$(dirname "$dest")"
        cp "$body" "$dest"
        say "  wrote $path"
        wrote=$((wrote + 1))
    done

    rm -rf "$tmp"
    [ "$wrote" -gt 0 ] && say ""
    return 0
}

cmd_chat() {
    local name="${1:-}" dir
    if [ -n "$name" ]; then
        dir="$(require_project "$name")"
    elif [ -d "$PWD/.galla" ]; then
        dir="$PWD"; name="$(basename "$PWD")"
    else
        fail "usage: galla chat <project>   (or run it inside a project folder)"
    fi

    local base
    base="$(chat_endpoint)" ||
        fail "can't reach Ollama. Start it with:  OLLAMA_ORIGINS=\"*\" ollama serve"

    local model
    model="$(chat_model)" || exit 1
    say "Galla is in $name   ($model)"
    say "Ask for what you want built. /files lists them, /publish ships it, /exit leaves."
    say ""

    local history="" line reply msgs context
    while :; do
        printf 'you   > '
        IFS= read -r line || { say ""; break; }
        case "$line" in
            "")            continue ;;
            /exit|/quit|q) break ;;
            /files)        (cd "$dir" && find . -type f -not -path './.git/*' -not -path './.galla/*' | sed 's|^\./|  |'); say ""; continue ;;
            /publish)      cmd_publish "$name" || true; continue ;;
        esac

        if [ -z "$history" ]; then
            # The brief and the current files ride in the first turn, the same
            # shape the chat app uses, so no system message is needed and the
            # Modelfile's own SYSTEM block survives.
            context="$(project_context "$dir")"
            msgs="{\"role\":\"user\",\"content\":\"$(json_escape "$CHAT_BRIEF

Files in the project right now:$context

$line")\"}"
        else
            msgs="$history,{\"role\":\"user\",\"content\":\"$(json_escape "$line")\"}"
        fi

        printf 'Galla > '
        reply="$(curl -sS --no-buffer -X POST "$base/api/chat" \
            -H 'Content-Type: application/json' \
            -d "{\"model\":\"$model\",\"messages\":[$msgs],\"stream\":true}" \
            2>/dev/null | ndjson_text | tee /dev/stderr)"
        say ""

        if [ -z "$reply" ]; then
            warn "no reply - is $model pulled?  ollama pull $model"
            continue
        fi

        history="$msgs,{\"role\":\"assistant\",\"content\":\"$(json_escape "$reply")\"}"
        write_files "$dir" "$reply"
    done
    say "Left $name."
}

# -------------------------------------------------------------- connector
CONNECTOR="${GALLA_CONNECTOR:-$CONFIG_DIR/connector.py}"
CONNECT_PORT=4316

# The token is what stops the fixed port being enough on its own: anything else
# on this machine can reach 4316, so reaching it must not be sufficient.
connect_token() {
    load_config
    if [ -z "${GALLA_CONNECT_TOKEN:-}" ]; then
        GALLA_CONNECT_TOKEN="$(head -c 24 /dev/urandom | od -An -tx1 | tr -d ' \n')"
        save_config
    fi
    printf '%s' "$GALLA_CONNECT_TOKEN"
}

cmd_connect() {
    command -v python3 >/dev/null 2>&1 || fail \
"python3 is needed to run the connector.
  Termux:  pkg install -y python
  Debian:  sudo apt install -y python3
  macOS:   brew install python"

    [ -f "$CONNECTOR" ] || fail "connector is missing from $CONNECTOR. Run 'galla update'."

    local token; token="$(connect_token)"
    say "Galla CLI connector"
    say ""
    say "  Port:      $CONNECT_PORT (loopback only)"
    say "  Projects:  $WORKSPACE"
    say ""
    say "In the chat app, open Connectors and pair Galla CLI with this token:"
    say ""
    say "    $token"
    say ""
    say "Leave this running while you work. Ctrl-C disconnects."
    say ""

    GALLA_CONNECT_TOKEN="$token" \
    GALLA_HOME="$WORKSPACE" \
    GALLA_BIN="$(command -v galla 2>/dev/null || printf 'galla')" \
    exec python3 "$CONNECTOR"
}

cmd_token() {
    say "$(connect_token)"
}

# ----------------------------------------------------------------- update
cmd_update() {
    local src="${GALLA_SOURCE:-https://raw.githubusercontent.com/Trey16885/rhododendron/main/CLI}"

    # One code path: whatever `curl ... | bash` does for a new install is what
    # an update does too.
    #
    # This used to fetch galla itself and compare VERSION strings, stopping
    # early when they matched. VERSION sat at 1.0.0 through every release, so
    # the comparison was always equal and the update always declined -- it
    # reported success while installing nothing. A number someone has to
    # remember to bump is not a safety check, it is a second thing to get
    # wrong; the installer simply fetches and replaces.
    say "Running the installer ..."
    say ""
    if ! curl -fsSL "$src/install.sh" | GALLA_SOURCE="$src" bash; then
        fail "update failed. The installer verifies before it replaces anything, so galla is untouched."
    fi
}

cmd_help() {
    cat <<EOF
galla $VERSION - make things and put them on the web.

  galla new <name>              start a project in $WORKSPACE
  galla list                    show your projects
  galla open <name>             resume one (opens a shell in it)

  galla auth [token]            save or replace your GitHub token
  galla whoami                  show who you are signed in as
  galla link <name> [owner/repo]  attach a repository (or create one)
  galla publish <name> [message]  commit, push, and put it on GitHub Pages

  galla chat [name]             talk to Galla; it writes files in the project
  galla models                  the models Galla can use
  galla model [name]            show or change the model Galla uses
  galla connect                 let the chat app work with these projects
  galla token                   show the pairing token again
  galla doctor [project]        check the token against GitHub, permission by permission
  galla update                  fetch the latest galla

Projects live in $WORKSPACE
Token lives in $CONFIG (readable only by you)
EOF
}

main() {
    local cmd="${1:-help}"; shift || true
    case "$cmd" in
        new)      cmd_new "$@" ;;
        list|ls)  cmd_list "$@" ;;
        open|resume) cmd_open "$@" ;;
        auth|login)  cmd_auth "$@" ;;
        whoami)   cmd_whoami "$@" ;;
        link)     cmd_link "$@" ;;
        publish)  cmd_publish "$@" ;;
        chat)     cmd_chat "$@" ;;
        connect)  cmd_connect "$@" ;;
        doctor)   cmd_doctor "$@" ;;
        model)    cmd_model "$@" ;;
        models)   cmd_models "$@" ;;
        token)    cmd_token "$@" ;;
        update|upgrade) cmd_update "$@" ;;
        help|-h|--help) cmd_help ;;
        version|-v|--version) say "galla $VERSION" ;;
        *) warn "galla: '$cmd' isn't a command."; say ""; cmd_help; exit 1 ;;
    esac
}

main "$@"
