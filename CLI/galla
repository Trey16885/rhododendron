}

main() {
    local cmd="${1:-help}"; shift || true
    case "$cmd" in
        new)      cmd_new "$@" ;;
        list|ls)  cmd_list "$@" ;;
        open|resume) cmd_open "$@" ;;
        auth|login)  cmd_auth "$@" ;;
        whoami)   cmd_whoami "$@" ;;
        link)     cmd_link "$@" ;;
        publish)  cmd_publish "$@" ;;
        chat)     cmd_chat "$@" ;;
        connect)  cmd_connect "$@" ;;
        token)    cmd_token "$@" ;;
        update|upgrade) cmd_update "$@" ;;
        help|-h|--help) cmd_help ;;
        version|-v|--version) say "galla $VERSION" ;;
        *) warn "galla: '$cmd' isn't a command."; say ""; cmd_help; exit 1 ;;
    esac
}

main "$@"
